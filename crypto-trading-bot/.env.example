# ─── Coinbase Advanced Trade API ──────────────────────────────────────────────
# Get legacy keys from: coinbase.com → Settings → API
# Get CDP keys from:    portal.cdp.coinbase.com
CB_API_KEY=your_api_key_here
CB_API_SECRET=your_api_secret_here

# ─── Mode ─────────────────────────────────────────────────────────────────────
# paper → simulated trades, zero real money
# live  → real orders (enable ONLY after paper-testing and backtesting)
TRADING_MODE=paper

# ─── Paper trading starting balance (USD) ─────────────────────────────────────
PAPER_BALANCE=3000
